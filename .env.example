# --- Alarm Management source system ---
ALARM_API_BASE_URL=http://localhost:8000
ALARM_API_TOKEN=demo-token
ALARM_DB_PATH=./data/alarm_simulator.db

# --- Work Order source system (second MCP domain) ---
WORK_ORDER_API_BASE_URL=http://localhost:8010
WORK_ORDER_API_TOKEN=demo-token
WORK_ORDER_DB_PATH=./data/work_orders.db

# --- MCP servers (candidate-developed) ---
MCP_ALARM_HOST=0.0.0.0
MCP_ALARM_PORT=9001
MCP_ALARM_URL=http://localhost:9001/mcp

MCP_WORKORDERS_HOST=0.0.0.0
MCP_WORKORDERS_PORT=9002
MCP_WORKORDERS_URL=http://localhost:9002/mcp

# --- LLM provider (copilot orchestration) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4o-mini

# --- RAG ---
RAG_DOCUMENTS_PATH=./rag/documents
RAG_INDEX_PATH=./rag/index
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MIN_SCORE=0.30

# --- Copilot / GUI ---
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000

LOG_LEVEL=INFO
